# Local verification artifacts.
artifacts/
!artifacts/.gitkeep
artifacts/upstream/

# Vendored upstream source is required by the Tauri build; ignore only its
# nested Git metadata and generated Rust outputs.
third_party/**/.git/
third_party/codex-plus-plus/target/

