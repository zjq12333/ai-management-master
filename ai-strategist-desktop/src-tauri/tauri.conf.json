{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "AI Strategist",
  "version": "1.0.0",
  "identifier": "dev.ai.strategist",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3123",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "acceptFirstMouse": true,
        "resizable": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "transparent": false,
        "fullscreen": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "resources": {
      "../../prelaunch_bridge.py": "prelaunch_bridge.py",
      "../../prelaunch_manager.py": "prelaunch_manager.py",
      "../../repair_codex_desktop_history.py": "repair_codex_desktop_history.py",
      "../../codex_desktop_app_paths.py": "codex_desktop_app_paths.py",
      "../../codex_desktop_launcher.py": "codex_desktop_launcher.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "bundleName": "AI Strategist",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  },
  "plugins": {}
}
