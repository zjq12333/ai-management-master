__pycache__/
*.pyc
repair-*.log
*.bak

*.zip

# Local runtime state and generated assistant context.
.ai-strategist/
.codegraph/
.superpowers/
reports/

# Python/test caches.
.pytest_cache/

# Node/Tauri dependencies and build outputs.
node_modules/
ai-strategist-desktop/node_modules/
ai-strategist-desktop/dist/
ai-strategist-desktop/src-tauri/target/
ai-strategist-desktop/src-tauri/gen/
